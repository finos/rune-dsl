namespace test.condition

isProduct root Simple;

type Simple:
    val string (1..1)

    condition NotForbidden:
        val <> "forbidden"

    condition NotEmpty:
        val <> ""

func Qualify_Simple:
    [qualification Product]
    inputs:
        simple Simple (1..1)
    output:
        is_product boolean (1..1)
    set is_product:
        simple -> val exists

typeAlias Bounded(lowerBound int, upperBound int):
    int

    condition InRange:
        item >= lowerBound and item <= upperBound

type Range:
    quantity Bounded(lowerBound: 0, upperBound: 100) (1..1)

type WithDependency:
    val string (1..1)

    condition UsesFunction:
        IsAllowed

func IsAllowed:
    inputs:
        input WithDependency (1..1)
    output:
        result boolean (1..1)
    set result:
        input -> val <> "forbidden"

type SpansSeveralLines:
    val string (1..1)

    condition NotAMultiLineText:
        val <> "first line
second line"
