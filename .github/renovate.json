{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboardLabels": [
    "dependencies"
  ],
  "prConcurrentLimit": 6,
  "prHourlyLimit": 0,
  "timezone": "Europe/London",
  "schedule": [
    "* 6-9 * * 1"
  ],
  "assignees": [
    "SimonCockx"
  ],
  "packageRules": [
    {
      "description": "Label Maven dependency updates as Java.",
      "matchDatasources": [
        "maven"
      ],
      "addLabels": [
        "java"
      ]
    },
    {
      "description": "com.regnosys and Rune artifacts are bumped deliberately as part of release coordination, not by a bot.",
      "matchPackageNames": [
        "/^com\\.regnosys[.:]/",
        "/^org\\.finos\\.rune[.:]/"
      ],
      "enabled": false
    },
    {
      "description": "Xtext and Jackson are kept off minor and major bumps entirely. Only patch updates are allowed through, and standalone rather than grouped.",
      "matchPackageNames": [
        "/^org\\.eclipse\\.xtext[.:]/",
        "/^com\\.fasterxml\\.jackson[.:]/"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "Guice stays on major version 6. Minor and patch updates are fine.",
      "matchPackageNames": [
        "/^com\\.google\\.inject[.:]/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "One PR for routine Maven minor/patch drift. Majors still come through individually so they get read properly.",
      "matchDatasources": [
        "maven"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "maven minor and patch",
      "groupSlug": "maven-minor-and-patch",
      "matchPackageNames": [
        "!/^org\\.eclipse\\./",
        "!/^com\\.fasterxml\\.jackson[.:]/"
      ]
    },
    {
      "description": "One PR for routine npm minor/patch drift (VS Code plugin, website and local GitHub Actions).",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm minor and patch",
      "groupSlug": "npm-minor-and-patch"
    },
    {
      "description": "Group the remaining Eclipse dependencies (EMF, Xcore, LSP4J). These often introduce breaking changes in minor version upgrades. Xtext is excluded so its patch updates stay standalone.",
      "groupName": "eclipse dependencies",
      "groupSlug": "eclipse-dependencies",
      "matchPackageNames": [
        "/^org\\.eclipse\\./",
        "!/^org\\.eclipse\\.xtext[.:]/"
      ]
    },
    {
      "description": "The build requires Java 21 exactly, so the JDK used in CI stays on major version 21.",
      "matchPackageNames": [
        "java-jdk"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Check GitHub Actions monthly.",
      "matchManagers": [
        "github-actions"
      ],
      "schedule": [
        "* 6-9 1 * *"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Because the Node version we use for building the VS Code plugin is managed by a Maven plugin, we need a custom regex version detection strategy. This rule matches versions defined as a Maven property of the form <node.version>x.x.x</node.version>.",
      "managerFilePatterns": [
        "/\\.pom\\.xml$/",
        "/(^|/)pom\\.xml$/"
      ],
      "matchStrings": [
        "<node\\.version>(?<currentValue>.*?)<\\/node\\.version>"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Detect Maven goals in GitHub workflows and actions.",
      "managerFilePatterns": [
        "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/",
        "/(^|/)action\\.ya?ml$/"
      ],
      "matchStrings": [
        "mvn (?<depName>[^\\s:]+:[^\\s:]+):(?<currentValue>[^\\s:]+):[^\\s:]+"
      ],
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Detect OWASP Dependency-Check Docker image tags in workflow shell steps.",
      "managerFilePatterns": [
        "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/",
        "/(^|/)action\\.ya?ml$/"
      ],
      "matchStrings": [
        "owasp\\/dependency-check:(?<currentValue>[^\\s\"'\\\\]+)"
      ],
      "depNameTemplate": "owasp/dependency-check",
      "datasourceTemplate": "docker"
    }
  ]
}
